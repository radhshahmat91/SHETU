# Copy to .env and adjust
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/setu_college_portal
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
COLLEGE_NAME=Greenfield College

# Email notifications (same provider the report used). Leave the key empty and
# emails are written to the Email log (Admin > System) and the console instead.
SENDGRID_API_KEY=
MAIL_FROM=Setu Portal <no-reply@your-verified-domain.com>
